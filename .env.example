# GitHub OAuth App (Auth.js, identity only — read:user scope)
GITHUB_ID=
GITHUB_SECRET=
# Random secret used to sign the session cookie: `openssl rand -base64 32`
AUTH_SECRET=

# Phase 9 (submit API) — fine-grained PAT scoped to CONTENT_REPO_OWNER/NAME
# with Contents: RW, Pull requests: RW, Metadata: R.
BOT_GITHUB_TOKEN=
CONTENT_REPO_OWNER=
CONTENT_REPO_NAME=
